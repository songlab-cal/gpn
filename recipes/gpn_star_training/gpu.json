{
  "dataset_name": "/path/to/prepared-gpn-star-dataset",
  "msa_path": "/path/to/prepared-msa/100",
  "phylo_dist_path": "/path/to/prepared-phylo-dist",
  "model_type": "GPNStar",
  "config_overrides": "time_enc=fire_1,clade_thres=0.2,num_hidden_layers=16,num_attention_heads=16,hidden_size=1024,intermediate_size=4096,max_position_embeddings=1536",
  "do_train": true,
  "do_eval": true,
  "max_steps": 100000,
  "per_device_train_batch_size": 16,
  "per_device_eval_batch_size": 8,
  "gradient_accumulation_steps": 4,
  "mlm_probability": 0.15,
  "soft_masked_loss_weight_train": 0.1,
  "soft_masked_loss_weight_evaluation": 0.0,
  "use_aux_features": true,
  "weight_conserved": "True",
  "flip_nonconserved": 0.0,
  "learning_rate": 0.00005,
  "lr_scheduler_type": "cosine",
  "warmup_steps": 2500,
  "weight_decay": 0.01,
  "optim": "adamw_torch",
  "seed": 42,
  "dataloader_num_workers": 4,
  "remove_unused_columns": false,
  "prediction_loss_only": true,
  "eval_strategy": "steps",
  "eval_steps": 5000,
  "save_strategy": "steps",
  "save_steps": 5000,
  "save_total_limit": 1,
  "logging_steps": 1000,
  "bf16": true,
  "bf16_full_eval": true,
  "torch_compile": true,
  "ddp_find_unused_parameters": false,
  "report_to": [],
  "output_dir": "outputs/gpn-star",
  "run_name": "gpn-star-canonical"
}
